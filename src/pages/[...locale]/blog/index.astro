---
import Base from '../../../layouts/Base.astro';
import WorkCard from '../../../components/WorkCard.astro';
import { collectionFor } from '../../../i18n/content.js';
import { useTranslations, localise } from '../../../i18n/ui.js';
import { localePaths, alternatesFor } from '../../../i18n/routes.js';

export function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await collectionFor('blog', lang)).sort((a, b) => b.data.date - a.data.date);

const covers = import.meta.glob('../../../content/blog/*/featured.{png,jpg,jpeg,webp}', {
  eager: true,
});
const coverFor = (slug) =>
  Object.entries(covers).find(([path]) => path.includes(`/${slug}/`))?.[1]?.default;

/** Dates read in the language of the page, not in the language of the build. */
const LOCALES = { en: 'en-GB', it: 'it-IT' };
const formatDate = (date) =>
  date.toLocaleDateString(LOCALES[lang], { year: 'numeric', month: 'short', day: 'numeric' });

const categorizePost = (tags = []) => {
  const lower = tags.map((t) => t.toLowerCase());
  if (lower.some((t) => t.includes('conference') || t.includes('conferenz'))) return 'conference';
  if (lower.some((t) => t.includes('workshop'))) return 'workshop';
  if (lower.some((t) => t.includes('award') || t.includes('premi'))) return 'award';
  return 'news';
};
---

<Base
  title={t('blog.title')}
  description={t('blog.description')}
  scene={false}
  lang={lang}
  alternates={alternatesFor('/blog/')}
>
  <main class="page page-wide">
    <header class="page-head">
      <p class="page-kicker">{posts.length} {t('blog.count')}</p>
      <h1>{t('blog.headingA')} <em>{t('blog.headingB')}</em></h1>
      <p class="page-lede">{t('blog.lede')}</p>
    </header>

    <ul class="filter-bar" role="tablist" aria-label="News categories">
      <li>
        <button
          type="button"
          class="filter-chip is-active"
          data-filter="all"
          aria-pressed="true"
        >
          {t('blog.filterAll')}
        </button>
      </li>
      <li>
        <button
          type="button"
          class="filter-chip"
          data-filter="conference"
          aria-pressed="false"
        >
          {t('blog.filterConferences')}
        </button>
      </li>
      <li>
        <button
          type="button"
          class="filter-chip"
          data-filter="workshop"
          aria-pressed="false"
        >
          {t('blog.filterWorkshops')}
        </button>
      </li>
      <li>
        <button
          type="button"
          class="filter-chip"
          data-filter="award"
          aria-pressed="false"
        >
          {t('blog.filterAwards')}
        </button>
      </li>
    </ul>

    <div class="card-grid">
      {
        posts.map((post, i) => (
          <WorkCard
            href={localise(`/blog/${post.id}/`, lang)}
            title={post.data.title}
            summary={post.data.summary}
            tags={post.data.tags}
            image={coverFor(post.id)}
            index={i + 1}
            kind={formatDate(post.data.date)}
            category={categorizePost(post.data.tags)}
          />
        ))
      }
    </div>
  </main>

  <script is:inline>
    (() => {
      const chips = document.querySelectorAll('.filter-chip');
      const cards = document.querySelectorAll('.card-grid .card');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => {
            c.classList.remove('is-active');
            c.setAttribute('aria-pressed', 'false');
          });
          chip.classList.add('is-active');
          chip.setAttribute('aria-pressed', 'true');
          const filter = chip.dataset.filter;
          cards.forEach((card) => {
            const matches = filter === 'all' || card.dataset.category === filter;
            card.style.display = matches ? '' : 'none';
          });
        });
      });
    })();
  </script>
</Base>
